# Copy sang gitlab.env rồi điền giá trị thật. gitlab.env đã bị .gitignore.
#   cp gitlab.env.example gitlab.env && $EDITOR gitlab.env && ./bootstrap.sh
#
# Sinh mật khẩu:  openssl rand -base64 24
# Tối thiểu 12 ký tự, nếu không GitLab bỏ qua và tự đặt một mật khẩu ngẫu
# nhiên rồi ghi vào /etc/gitlab/initial_root_password trong pod.
root_password=
